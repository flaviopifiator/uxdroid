diff --git a/b/cc/config/arm64_linux_glibc_host.go b/cc/config/arm64_linux_glibc_host.go
new file mode 100644
index 0000000..ef85063
--- /dev/null
+++ b/cc/config/arm64_linux_glibc_host.go
@@ -0,0 +1,82 @@
+// Copyright 2026 The uxdroid authors. Licensed under the Apache License, Version 2.0.
+
+package config
+
+import (
+	"strings"
+
+	"android/soong/android"
+)
+
+// uxdroid: linux_glibc on arm64, built as a host-cross target from an x86_64 machine against the
+// aarch64 sysroot runtime/art/sysroot_arm64.sh makes from Debian 11's packages (glibc 2.31 and
+// GCC 10's crt files and libgcc). The flags are the x86_64 glibc host's, with that sysroot in
+// place of the x86_64 GCC prebuilt.
+var (
+	linuxGlibcArm64Cflags = []string{
+		"-Wa,--noexecstack",
+		"-fPIC",
+		"-fno-omit-frame-pointer",
+		"-U_FORTIFY_SOURCE",
+		"-D_FORTIFY_SOURCE=3",
+		"-fstack-protector",
+		"--gcc-toolchain=${LinuxGlibcArm64Root}/sysroot/usr",
+		"--sysroot ${LinuxGlibcArm64Root}/sysroot",
+		"-fstack-protector-strong",
+		"-march=armv8-a",
+	}
+
+	linuxGlibcArm64Ldflags = []string{
+		"-Wl,-z,noexecstack",
+		"-Wl,-z,relro",
+		"-Wl,-z,now",
+		"-Wl,--no-undefined-version",
+		"--gcc-toolchain=${LinuxGlibcArm64Root}/sysroot/usr",
+		"--sysroot ${LinuxGlibcArm64Root}/sysroot",
+		// No CPU is named for a host, so assume it needs the erratum's fix, as linux_bionic does.
+		"-Wl,--fix-cortex-a53-843419",
+	}
+
+	linuxGlibcArm64Lldflags = append(android.CopyOf(linuxGlibcArm64Ldflags),
+		"-Wl,--compress-debug-sections=zstd",
+	)
+)
+
+func init() {
+	pctx.SourcePathVariable("LinuxGlibcArm64Root",
+		"prebuilts/gcc/linux-x86/host/aarch64-linux-glibc2.31-10")
+	pctx.StaticVariable("LinuxGlibcArm64Cflags", strings.Join(linuxGlibcArm64Cflags, " "))
+	pctx.StaticVariable("LinuxGlibcArm64Ldflags", strings.Join(linuxGlibcArm64Ldflags, " "))
+	pctx.StaticVariable("LinuxGlibcArm64Lldflags", strings.Join(linuxGlibcArm64Lldflags, " "))
+}
+
+type toolchainLinuxGlibcArm64 struct {
+	toolchainLinuxArm64
+	toolchainGlibc
+}
+
+func (t *toolchainLinuxGlibcArm64) ClangTriple() string {
+	return "aarch64-linux-gnu"
+}
+
+func (t *toolchainLinuxGlibcArm64) Cflags() string {
+	return "${config.LinuxGlibcArm64Cflags}"
+}
+
+func (t *toolchainLinuxGlibcArm64) Ldflags() string {
+	return "${config.LinuxGlibcArm64Ldflags}"
+}
+
+func (t *toolchainLinuxGlibcArm64) Lldflags() string {
+	return "${config.LinuxGlibcArm64Lldflags}"
+}
+
+var toolchainLinuxGlibcArm64Singleton Toolchain = &toolchainLinuxGlibcArm64{}
+
+func linuxGlibcArm64ToolchainFactory(arch android.Arch) Toolchain {
+	return toolchainLinuxGlibcArm64Singleton
+}
+
+func init() {
+	registerToolchainFactory(android.Linux, android.Arm64, linuxGlibcArm64ToolchainFactory)
+}
