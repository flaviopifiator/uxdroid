<?xml version="1.0" encoding="utf-8"?>
<!-- An app that asks the framework what the compatibility corpus asks: its identity, storage and
     system services. Each answer is printed for compat_smoke.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.compat">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <application android:name=".CompatApplication" android:label="@string/app_name"
        android:appComponentFactory="com.example.compat.CompatFactory" android:appCategory="game"
        android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".CompatActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Started by the launcher activity itself, as a trampoline starts the app's real screen. -->
        <activity android:name=".SecondActivity" android:exported="false">
            <intent-filter>
                <action android:name="com.example.compat.SECOND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
