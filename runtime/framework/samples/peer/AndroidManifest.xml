<?xml version="1.0" encoding="utf-8"?>
<!-- A second app, installed over the same data directory as the compat sample, so each can query,
     resolve and look up the other through its PackageManager (compat_smoke.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.peer"
    android:versionCode="3" android:versionName="1.3">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light">
        <meta-data android:name="com.example.peer.flavor" android:value="peer" />
        <activity android:name=".PeerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Takes peer: links from any app. -->
        <activity android:name=".ViewerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="peer" />
            </intent-filter>
        </activity>
        <!-- Takes the same links, but only from this app: other apps are never offered it. -->
        <activity android:name=".HiddenActivity" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="peer" />
            </intent-filter>
        </activity>
        <service android:name=".PeerService" android:exported="true">
            <intent-filter>
                <action android:name="com.example.peer.SERVICE" />
            </intent-filter>
            <meta-data android:name="com.example.peer.service" android:value="bound" />
        </service>
        <provider android:name=".PeerProvider" android:authorities="com.example.peer.provider"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.peer.PROVIDE" />
            </intent-filter>
        </provider>
    </application>
</manifest>
