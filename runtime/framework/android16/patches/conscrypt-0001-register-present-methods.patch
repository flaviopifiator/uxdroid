diff --git a/common/src/jni/main/cpp/conscrypt/native_crypto.cc b/common/src/jni/main/cpp/conscrypt/native_crypto.cc
index ba92648..38ba139 100644
--- a/common/src/jni/main/cpp/conscrypt/native_crypto.cc
+++ b/common/src/jni/main/cpp/conscrypt/native_crypto.cc
@@ -11677,9 +11677,28 @@ static JNINativeMethod sNativeCryptoMethods[] = {
 };
 
 void NativeCrypto::registerNativeMethods(JNIEnv* env) {
+#if defined(UXDROID_REGISTER_PRESENT_METHODS)
+    // uxdroid: the arm64 host runtime pairs this library with the conscrypt.jar of ART's Mainline
+    // SDK, as x86_64 does, which predates some of these natives: each is registered on its own and
+    // one the class does not declare is left out.
+    jclass c = env->FindClass(TO_STRING(JNI_JARJAR_PREFIX) "org/conscrypt/NativeCrypto");
+    if (c == nullptr) {
+        conscrypt::jniutil::jniRegisterNativeMethods(
+                env, TO_STRING(JNI_JARJAR_PREFIX) "org/conscrypt/NativeCrypto", sNativeCryptoMethods,
+                NELEM(sNativeCryptoMethods));
+        return;
+    }
+    for (size_t i = 0; i < NELEM(sNativeCryptoMethods); i++) {
+        if (env->RegisterNatives(c, &sNativeCryptoMethods[i], 1) != JNI_OK) {
+            env->ExceptionClear();
+        }
+    }
+    env->DeleteLocalRef(c);
+#else
     conscrypt::jniutil::jniRegisterNativeMethods(
             env, TO_STRING(JNI_JARJAR_PREFIX) "org/conscrypt/NativeCrypto", sNativeCryptoMethods,
             NELEM(sNativeCryptoMethods));
+#endif
 }
 
