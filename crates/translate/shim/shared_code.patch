+// One region of address space for all of a cache's emitters, so a jump from one emitter's code
+// reaches another's with a 32-bit displacement. Each emitter's BlockOfCode takes the next part.
+class RegionAllocator final : public Xbyak::Allocator {
+public:
+    RegionAllocator(size_t parts, size_t part_size)
+            : part_size(part_size), size(parts * part_size) {
+        ASSERT(size <= 0x7FFF'0000);
+        void* mapped = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+        ASSERT_MSG(mapped != MAP_FAILED, "cannot reserve a code region");
+        base = static_cast<u8*>(mapped);
+    }
+    ~RegionAllocator() override {
+        munmap(base, size);
+    }
+
+    uint8_t* alloc(size_t wanted) override {
+        ASSERT(wanted <= part_size && next * part_size < size);
+        return base + part_size * next++;
+    }
+    // The region goes as a whole, with the cache.
+    void free(uint8_t*) override {}
+
+private:
+    const size_t part_size;
+    const size_t size;
+    u8* base = nullptr;
+    size_t next = 0;
+};
