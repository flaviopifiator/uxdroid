+// uxdroid: patch locations that one aligned atomic store retargets, since other threads may be
+// running the code around them. A conditional location is
+//
+//     nops, so that the displacement below is 4-byte aligned
+//     0F 8x rel32          ; jg or jz to the target, or to the stub below when unlinked
+//     EB xx                ; not taken: on to the code after the location
+//     stub: mov rax, pc; mov [r15 + pc], rax; jmp return_from_run_code
+//
+// an unconditional one is `E9 rel32` with the same alignment and the stub right after it, and a
+// return stack buffer entry is `mov rcx, imm64` with the immediate 8-byte aligned. Only the
+// displacement or the immediate ever changes after emission, so a thread fetching it sees either
+// target in full: an aligned store of 4 or 8 bytes never splits across a cache line, and x86
+// keeps instruction fetch coherent with such a store (HotSpot patches calls the same way). The
+// target code is written before the store that publishes it, under the cache's lock.
+namespace {
+
+constexpr size_t JCC_LENGTH = 6;
+constexpr size_t SHORT_JMP_LENGTH = 2;
+constexpr size_t JMP_LENGTH = 5;
+
+size_t PaddingFor(CodePtr location, size_t offset, size_t alignment) {
+    const auto address = reinterpret_cast<std::uintptr_t>(location) + offset;
+    return (alignment - address % alignment) % alignment;
+}
+
+void StoreRel32(CodePtr instruction_end, CodePtr target) {
+    const auto from = reinterpret_cast<std::intptr_t>(instruction_end);
+    const auto to = reinterpret_cast<std::intptr_t>(target);
+    const std::intptr_t displacement = to - from;
+    ASSERT(displacement >= INT32_MIN && displacement <= INT32_MAX);
+    auto* field = reinterpret_cast<std::int32_t*>(reinterpret_cast<std::uintptr_t>(instruction_end) - 4);
+    ASSERT(reinterpret_cast<std::uintptr_t>(field) % 4 == 0);
+    __atomic_store_n(field, static_cast<std::int32_t>(displacement), __ATOMIC_RELEASE);
+}
+
+}  // namespace
+
+void A64EmitX64::EmitPatchJcc(u8 opcode, const IR::LocationDescriptor& target_desc, CodePtr target_code_ptr) {
+    // The displacement starts 2 bytes into the instruction.
+    code.nop(PaddingFor(code.getCurr(), 2, 4));
+    const u8* site = code.getCurr<const u8*>();
+    Xbyak::Label after;
+    code.db(0x0F);
+    code.db(opcode);
+    code.dd(0);
+    code.jmp(after, Xbyak::CodeGenerator::T_SHORT);
+    ASSERT(code.getCurr<const u8*>() == site + JCC_LENGTH + SHORT_JMP_LENGTH);
+    code.mov(rax, A64::LocationDescriptor{target_desc}.PC());
+    code.mov(qword[r15 + offsetof(A64JitState, pc)], rax);
+    code.jmp(code.GetReturnFromRunCodeAddress());
+    code.L(after);
+    StoreRel32(site + JCC_LENGTH, target_code_ptr ? target_code_ptr : site + JCC_LENGTH + SHORT_JMP_LENGTH);
+}
